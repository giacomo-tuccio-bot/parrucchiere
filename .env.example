# Service account Google (Google Cloud → IAM → Service account → chiave JSON)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# ID del calendario del salone (Impostazioni calendario → Integra calendario → ID calendario)
GOOGLE_CALENDAR_ID=

# PIN per entrare in /admin (da condividere con i dipendenti)
ADMIN_PIN=

# Quanti giorni in anticipo si può prenotare online (default 60)
BOOKING_DAYS_AHEAD=60

# Facoltativo: notifiche email via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SALON_EMAIL=
